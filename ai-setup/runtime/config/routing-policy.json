{
  "schema": "universal-ai-stack.routing-policy.v1",
  "updated": "2026-06-18",
  "defaultRoute": "auto-coding",
  "fallbackOrder": [
    "gpt-5.5",
    "kimi-k2.6-thinking",
    "openrouter-auto",
    "claude-opus-4.7",
    "qwen3-coder-30b-a3b-q4"
  ],
  "httpRouter": {
    "listenHost": "127.0.0.1",
    "listenPort": 18100,
    "requireApiKey": true,
    "apiKeyEnv": "UNIVERSAL_AI_STACK_API_KEY",
    "exposedModels": [
      "auto-coding",
      "primary-api",
      "local-coding",
      "qwen3-coder-30b-a3b-q4",
      "kimi-k2.6-thinking",
      "openrouter-coding",
      "openrouter-auto"
    ],
    "skipHostSessionProviders": true,
    "skipHostSessionProvidersReason": "Browser/CLI subscription sessions cannot be safely exposed as a generic HTTP API. Hermes/Codex use them directly; the HTTP router handles Kimi and local fallbacks."
  },
  "retry": {
    "maxAttemptsPerProvider": 1,
    "totalProviderAttempts": 5,
    "globalTimeoutSeconds": 240,
    "timeoutSeconds": 180,
    "retryableHttpStatus": [
      408,
      409,
      425,
      429,
      500,
      502,
      503,
      504
    ],
    "fallbackHttpStatus": [
      400,
      401,
      403,
      408,
      409,
      425,
      429,
      500,
      502,
      503,
      504
    ],
    "backoffSeconds": [
      1,
      3,
      8
    ],
    "circuitBreaker": {
      "enabled": true,
      "failureThreshold": 2,
      "cooldownSeconds": 600
    }
  },
  "agentSafety": {
    "maxConcurrentLocalAgents": 1,
    "maxConcurrentCloudAgents": 2,
    "maxTaskRuntimeSeconds": 900,
    "maxAgentIterations": 30,
    "maxToolCalls": 60,
    "stopOnRepeatedError": true,
    "requireConfirmationForLongRunningLoops": true
  },
  "costPolicy": {
    "preferSubscriptionCliAuth": true,
    "avoidPaidApiUnlessNeeded": true,
    "primaryPaidApiProvider": "kimi-k2.6-thinking",
    "localModelsOnlyAfterCloudFailure": true,
    "openRouterProvider": "openrouter-auto"
  },
  "supervisor": {
    "checkIntervalSeconds": 600,
    "startOnLogin": true,
    "windowMode": "hidden",
    "startOllamaOnLogin": false,
    "startLocalHeavyBackendsOnLogin": false,
    "startLocalQwenProxiesOnLogin": true
  },
  "logging": {
    "directory": "{{USERPROFILE}}\\.universal-ai-stack\\logs",
    "redactSecrets": true,
    "maxLogMb": 10
  }
}
