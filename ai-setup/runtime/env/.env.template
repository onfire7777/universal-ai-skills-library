# Universal AI Stack local environment template.
# Copy to %USERPROFILE%\.universal-ai-stack\secrets\.env or let install-universal-ai-stack.ps1 create it.
# Never commit or paste the real secrets.

UNIVERSAL_AI_STACK_HOME={{USERPROFILE}}\.universal-ai-stack
UNIVERSAL_AI_STACK_API_KEY=

# Primary API fallback. Prefer Kimi CLI/session auth when a tool supports it.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL_NAME=kimi-k2.6
KIMI_MODEL_CAPABILITIES=thinking
KIMI_MODEL_MAX_CONTEXT_SIZE=262144

# Hermes gateway and Discord.
API_SERVER_KEY=
HERMES_API_KEY=
HERMES_INFERENCE_PROVIDER=openai-codex
HERMES_MODEL=gpt-5.5
HERMES_REASONING_EFFORT=xhigh
HERMES_MAX_ITERATIONS=30
REASONING_EFFORT=xhigh
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_CHANNELS=
DISCORD_FREE_RESPONSE_CHANNELS=
DISCORD_HOME_CHANNEL=
DISCORD_HOME_CHANNEL_NAME=Hermes-Agent

# Keep canceled cloud API keys empty unless intentionally re-enabled.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
