{
  "schema": "universal-ai-setup.source-repos.v1",
  "updated": "2026-05-14",
  "purpose": "Portable inventory of source repositories and runtime roots used by the Universal AI Skills Library installer. Paths are templates and must be resolved by install scripts.",
  "canonical": {
    "universalAiSkillsLibrary": {
      "role": "source-of-truth",
      "pathTemplate": "{{REPO_ROOT}}",
      "skillCorpus": "{{REPO_ROOT}}\\skills",
      "routerSource": "{{REPO_ROOT}}\\skill-router-cli",
      "repoRemote": "https://github.com/onfire7777/universal-ai-skills-library.git"
    }
  },
  "localRuntimeTargets": {
    "universalAiStack": "{{USERPROFILE}}\\.universal-ai-stack",
    "secretsEnv": "{{USERPROFILE}}\\.universal-ai-stack\\secrets\\.env",
    "localAiRuntime": "{{USERPROFILE}}\\.local-ai",
    "defaultQwenModelRoot": "D:\\AI\\models\\qwen3-coder-30b-a3b",
    "defaultQwenProxyRoot": "{{USERPROFILE}}\\.universal-ai-stack\\bin"
  },
  "managedClientRoots": [
    {
      "id": "agent",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.agent\\AGENTS.md",
      "skills": "{{USERPROFILE}}\\.agent\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "agents",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.agents\\AGENTS.md",
      "skills": "{{USERPROFILE}}\\.agents\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "codex",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.codex\\AGENTS.md",
      "skills": "{{USERPROFILE}}\\.codex\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "aion-codex-home",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\AppData\\Roaming\\AionUi\\codex-home\\AGENTS.md",
      "skills": "{{USERPROFILE}}\\AppData\\Roaming\\AionUi\\codex-home\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "claude",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.claude\\CLAUDE.md",
      "skills": "{{USERPROFILE}}\\.claude\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "cursor",
      "kind": "repo-instruction",
      "instructions": "{{USERPROFILE}}\\.cursor\\rules\\openskills.md",
      "skills": "{{USERPROFILE}}\\.cursor\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "continue",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.continue\\AGENTS.md",
      "skills": "{{USERPROFILE}}\\.continue\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "hermes",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.hermes\\AGENTS.md",
      "skills": "{{USERPROFILE}}\\.hermes\\skills",
      "mode": "custom-plus-wrapper"
    },
    {
      "id": "paperclip",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.paperclip\\universal-ai-skills\\AGENTS.md",
      "skills": "{{USERPROFILE}}\\.paperclip\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "opencode-home",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.opencode\\AGENTS.md",
      "skills": "{{USERPROFILE}}\\.opencode\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "opencode-config",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.config\\opencode\\AGENTS.md",
      "skills": "{{USERPROFILE}}\\.config\\opencode\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "openhands",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.openhands\\AGENTS.md",
      "skills": "{{USERPROFILE}}\\.openhands\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "openclaw",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.openclaw\\AGENTS.md",
      "skills": "{{USERPROFILE}}\\.openclaw\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "gemini",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.gemini\\GEMINI.md",
      "skills": "{{USERPROFILE}}\\.gemini\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "kiro",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.kiro\\steering\\universal-ai-stack.md",
      "skills": "{{USERPROFILE}}\\.kiro\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "kimi",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.kimi\\AGENTS.md",
      "skills": "{{USERPROFILE}}\\.kimi\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "qwen",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.qwen\\AGENTS.md",
      "skills": "{{USERPROFILE}}\\.qwen\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "roo",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.roo\\AGENTS.md",
      "skills": "{{USERPROFILE}}\\.roo\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "windsurf",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.windsurf\\AGENTS.md",
      "skills": "{{USERPROFILE}}\\.windsurf\\skills",
      "mode": "compact-wrapper"
    },
    {
      "id": "aider",
      "kind": "skill-root",
      "instructions": "{{USERPROFILE}}\\.aider\\OPENSKILLS.md",
      "skills": "{{USERPROFILE}}\\.aider\\skills",
      "mode": "compact-wrapper"
    }
  ],
  "optionalExternalSources": [
    {
      "id": "gstack",
      "runtimeIntegrationId": "gskills-gstack",
      "pathTemplate": "{{USERPROFILE}}\\.gstack\\gstack",
      "loadPolicy": "read-only-indexed-through-skill-router"
    },
    {
      "id": "gbrain",
      "pathTemplate": "{{USERPROFILE}}\\gbrain",
      "loadPolicy": "read-only-indexed-through-skill-router"
    },
    {
      "id": "mempalace",
      "pathTemplate": "{{USERPROFILE}}\\.mempalace\\palace",
      "loadPolicy": "optional-mcp-or-direct-cli"
    },
    {
      "id": "context-mode",
      "pathTemplate": "%APPDATA%\\npm\\context-mode.cmd",
      "loadPolicy": "shared-cli-and-codex-hooks"
    },
    {
      "id": "lightpanda",
      "pathTemplate": "{{USERPROFILE}}\\.lightpanda-ai",
      "loadPolicy": "on-demand-wrapper"
    },
    {
      "id": "notebooklm-mcp-cli",
      "pathTemplate": "{{USERPROFILE}}\\.notebooklm-mcp-cli\\notebooklm-mcp-cli",
      "repoRemote": "https://github.com/jacob-bd/notebooklm-mcp-cli.git",
      "package": "notebooklm-mcp-cli",
      "commands": [
        "nlm",
        "notebooklm-mcp"
      ],
      "loadPolicy": "shared-uv-tool-cli-optional-mcp"
    },
    {
      "id": "x-cli",
      "pathTemplate": "{{USERPROFILE}}\\.x-cli\\x-cli",
      "repoRemote": "https://github.com/sferik/x-cli.git",
      "package": "x",
      "commands": [
        "x",
        "x-cli"
      ],
      "configFile": "{{USERPROFILE}}\\.xrc",
      "loadPolicy": "shared-source-build-cli-no-background-service"
    },
    {
      "id": "instagram-cli",
      "pathTemplate": "{{USERPROFILE}}\\.instagram-cli-source\\instagram-cli",
      "repoRemote": "https://github.com/supreme-gg-gg/instagram-cli.git",
      "package": "@i7m/instagram-cli",
      "version": "2.0.0",
      "commands": [
        "instagram-cli"
      ],
      "stateRoot": "{{USERPROFILE}}\\.instagram-cli",
      "loadPolicy": "shared-source-build-cli-no-background-service"
    },
    {
      "id": "crawl4ai",
      "pathTemplate": "{{USERPROFILE}}\\.crawl4ai-source\\crawl4ai",
      "repoRemote": "https://github.com/unclecode/crawl4ai.git",
      "package": "crawl4ai",
      "version": "0.8.6",
      "commands": [
        "crwl",
        "crawl4ai-setup",
        "crawl4ai-doctor"
      ],
      "stateRoot": "{{USERPROFILE}}\\.crawl4ai",
      "venv": "{{USERPROFILE}}\\.crawl4ai\\venv",
      "loadPolicy": "shared-source-venv-cli-no-background-service"
    },
    {
      "id": "firecrawl",
      "pathTemplate": "{{USERPROFILE}}\\.firecrawl-source\\firecrawl",
      "repoRemote": "https://github.com/firecrawl/firecrawl.git",
      "package": "firecrawl-cli",
      "version": "1.17.0",
      "mcpPackage": "firecrawl-mcp",
      "mcpVersion": "3.16.0",
      "commands": [
        "firecrawl"
      ],
      "auth": "FIRECRAWL_API_KEY or firecrawl login",
      "loadPolicy": "shared-source-npm-cli-optional-mcp-no-background-service"
    },
    {
      "id": "web-search",
      "pathTemplate": "host-native",
      "loadPolicy": "host-owned-no-local-service"
    },
    {
      "id": "skill-seekers",
      "pathTemplate": "{{USERPROFILE}}\\.skill-seekers",
      "loadPolicy": "optional-mcp-or-direct-cli"
    }
  ]
}
